# Supabase — get these from Project Settings > API Keys.
#
# Supabase renamed the legacy anon/service_role JWT keys to publishable/
# secret keys (format sb_publishable_... / sb_secret_...) — both work
# simultaneously during Supabase's migration window, but new projects
# should provision the new key types. Legacy anon/service_role keys are
# being phased out through the end of 2026. See:
# https://supabase.com/docs/guides/getting-started/migrating-to-new-api-keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Never expose to the client.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Legacy fallback — only set these if your project hasn't migrated to the
# new key types yet. Every client in this codebase prefers the new vars
# above and falls back to these only if they're missing.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Phase 3 — leave unset for now; notifications/payments will run in
# "not configured" placeholder mode until these are set (see
# lib/notifications/send.ts).
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
